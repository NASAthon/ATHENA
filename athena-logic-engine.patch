@@ -0,0 +1,31 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyScenario } from "./scenarios.js";
+
+const records = [
+  { missionDay: 9, sleepHours: 7, mood: 4 },
+  { missionDay: 10, sleepHours: 7, mood: 4, spo2: 98 },
+  { missionDay: 11, sleepHours: 7, mood: 1 },
+];
+
+test("changes only the chosen days, never the input", () => {
+  const out = applyScenario(records, { type: "sleepLoss", fromDay: 10, days: 2, intensity: 1 });
+  assert.equal(out[0], records[0]);
+  assert.equal(out[1].sleepHours, 4.5);
+  assert.equal(out[1].origin, "scenario");
+  assert.equal(records[1].sleepHours, 7);
+  assert.equal(out[2].mood, 1); // clamped to the 1–5 scale
+});
+
+test("never invents readings that weren't taken", () => {
+  const out = applyScenario(records, { type: "hypoxia", fromDay: 9, days: 3, intensity: 0.5 });
+  assert.equal(out[1].spo2, 94);
+  assert.equal("spo2" in out[0], false);
+  assert.equal(out[0].origin, undefined);
+});
+
+test("rejects bad input", () => {
+  assert.throws(() => applyScenario(records, { type: "zombies", fromDay: 1, days: 1, intensity: 1 }), RangeError);
+  assert.throws(() => applyScenario(records, { type: "fatigue", fromDay: 1, days: 0, intensity: 1 }), RangeError);
+  assert.throws(() => applyScenario(records, { type: "fatigue", fromDay: 1, days: 1, intensity: 2 }), RangeError);
+});
diff --git a/src/lib/engine/search.js b/src/lib/engine/search.js
new file mode 100644
index 0000000..15fa04b
--- /dev/null
+++ b/src/lib/engine/search.js
@@ -0,0 +1,159 @@
+// Offline search (docs/CHECKLIST.md › 2. Logic, item 13).
+// Pure logic: no React or DOM. Uses MiniSearch (MIT), already installed
+// (docs/DECISIONS.md › Search). Runs fully in the browser with no network.
+//
+// The content to index (indicators, measurement guides, emergency guides, alert
+// explanations, body parts, each with a `keywords` list) is CHECKLIST §1/§4 and
+// doesn't exist yet. This module only needs it in the SearchDocument shape below.
+
+import MiniSearch from "minisearch";
+
+/**
+ * One searchable item.
+ *
+ * @typedef {Object} SearchDocument
+ * @property {string} id      Unique across all content, e.g. "indicator:heartRate".
+ * @property {"indicator" | "guide" | "emergency" | "alert" | "bodyPart"} type
+ * @property {string} title   e.g. "Heart rate".
+ * @property {ReadonlyArray<string>} keywords Synonyms, plain-English terms, symptoms and common
+ *   misspellings, e.g. ["pulse", "heartbeat", "hart rate"] (DECISIONS › Search).
+ * @property {string} [text]  Optional short description to search as well.
+ */
+
+/**
+ * @typedef {Object} SearchHit
+ * @property {string} id
+ * @property {string} type
+ * @property {string} title
+ * @property {number} score
+ */
+
+/**
+ * @typedef {Object} SearchResponse
+ * @property {string} query               The normalised query actually searched.
+ * @property {ReadonlyArray<SearchHit>} results Best first; emergency guides first for symptom-like queries.
+ * @property {boolean} symptomLike        True if the query matched an emergency guide's keywords.
+ * @property {ReadonlyArray<string>} didYouMean Suggestions, only when there are no results.
+ * @property {true} emergencyShortcut     Always true: the UI always offers the emergency
+ *                                        guide, so search is never a dead end.
+ */
+
+/** Search options (DECISIONS › Search: typos, prefixes, field boosting). */
+const SEARCH_OPTIONS = Object.freeze({
+  prefix: true,
+  fuzzy: 0.2,
+  boost: Object.freeze({ title: 3, keywords: 2, text: 1 }),
+  combineWith: "OR",
+});
+
+/** Maximum results returned. */
+export const MAX_RESULTS = 10;
+
+/**
+ * Builds the search index once, from all content. Call again only if content changes.
+ *
+ * @param {ReadonlyArray<SearchDocument>} documents
+ * @returns {MiniSearch} The index (pass it to `search`).
+ * @throws {TypeError} If `documents` isn't an array or an id is missing or repeated.
+ */
+export function buildSearchIndex(documents) {
+  if (!Array.isArray(documents)) throw new TypeError("buildSearchIndex: documents must be an array.");
+  const seen = new Set();
+  const prepared = documents.map((doc) => {
+    if (!doc || typeof doc.id !== "string" || doc.id.length === 0) {
+      throw new TypeError("buildSearchIndex: every document needs a string id.");
+    }
+    if (seen.has(doc.id)) throw new TypeError(`buildSearchIndex: duplicate id "${doc.id}".`);
+    seen.add(doc.id);
+    return {
+      id: doc.id,
+      type: doc.type,
+      title: String(doc.title ?? ""),
+      keywords: Array.isArray(doc.keywords) ? doc.keywords.join(" ") : "",
+      text: String(doc.text ?? ""),
+    };
+  });
+
+  const index = new MiniSearch({
+    fields: ["title", "keywords", "text"],
+    storeFields: ["type", "title"],
+    processTerm: (term) => normaliseQuery(term) || null,
+  });
+  index.addAll(prepared);
+  return index;
+}
+
+/**
+ * Lower-cases, turns punctuation into spaces and collapses spaces, so case,
+ * punctuation and extra spaces never change the result (DECISIONS › Search).
+ * Word order already doesn't matter to the index.
+ *
+ * @param {unknown} query
+ * @returns {string}
+ */
+export function normaliseQuery(query) {
+  return String(query ?? "")
+    .toLowerCase()
+    .replace(/[^\p{L}\p{N}]+/gu, " ")
+    .trim()
+    .replace(/\s+/g, " ");
+}
+
+/**
+ * CHECKLIST §2: "Search index: offline fuzzy search over all content (typos, prefixes,
+ * synonyms, symptoms)".
+ *
+ * - Typos ("hart rate") and partial words ("oxy") match through fuzzy and prefix search.
+ * - Synonyms and symptoms match through each document's `keywords`.
+ * - If every word of the query matches an emergency guide's title or keywords, the
+ *   query is symptom-like and emergency guides are ranked first.
+ * - With no results, `didYouMean` holds the closest known terms. `emergencyShortcut`
+ *   is always true.
+ *
+ * Deterministic: equal scores are ordered by id.
+ *
+ * @param {MiniSearch} index From buildSearchIndex().
+ * @param {string} query What the astronaut typed.
+ * @returns {Readonly<SearchResponse>}
+ */
+export function search(index, query) {
+  const q = normaliseQuery(query);
+  if (q.length === 0) {
+    return Object.freeze({ query: q, results: Object.freeze([]), symptomLike: false, didYouMean: Object.freeze([]), emergencyShortcut: true });
+  }
+
+  const hits = index
+    .search(q, SEARCH_OPTIONS)
+    .map((r) => ({ id: r.id, type: r.type, title: r.title, score: r.score }))
+    .sort((a, b) => b.score - a.score || a.id.localeCompare(b.id));
+
+  const symptomLike =
+    index.search(q, {
+      fields: ["title", "keywords"],
+      prefix: true,
+      fuzzy: 0.2,
+      combineWith: "AND",
+      filter: (r) => r.type === "emergency",
+    }).length > 0;
+
+  const ordered = symptomLike
+    ? [...hits.filter((h) => h.type === "emergency"), ...hits.filter((h) => h.type !== "emergency")]
+    : hits;
+
+  const didYouMean =
+    ordered.length === 0
+      ? index
+          .autoSuggest(q, { fuzzy: 0.4, prefix: true })
+          .sort((a, b) => b.score - a.score || a.suggestion.localeCompare(b.suggestion))
+          .slice(0, 3)
+          .map((s) => s.suggestion)
+      : [];
+
+  return Object.freeze({
+    query: q,
+    results: Object.freeze(ordered.slice(0, MAX_RESULTS).map((h) => Object.freeze(h))),
+    symptomLike,
+    didYouMean: Object.freeze(didYouMean),
+    emergencyShortcut: true,
+  });
+}
diff --git a/src/lib/engine/search.test.js b/src/lib/engine/search.test.js
new file mode 100644
index 0000000..18a8e31
--- /dev/null
+++ b/src/lib/engine/search.test.js
@@ -0,0 +1,57 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { buildSearchIndex, normaliseQuery, search } from "./search.js";
+
+// Sample content for tests only; the real content is CHECKLIST §4.
+const docs = [
+  { id: "indicator:heartRate", type: "indicator", title: "Heart rate", keywords: ["pulse", "heartbeat", "bpm"] },
+  { id: "indicator:glucose", type: "indicator", title: "Blood glucose", keywords: ["sugar", "blood sugar", "glucos"] },
+  { id: "indicator:temperature", type: "indicator", title: "Body temperature", keywords: ["fever", "temp", "temprature"] },
+  { id: "indicator:spo2", type: "indicator", title: "Blood oxygen (SpO2)", keywords: ["oxygen", "low oxygen", "hypoxia", "oximeter"] },
+  { id: "indicator:sleep", type: "indicator", title: "Sleep hours", keywords: ["cant sleep", "insomnia", "tired"] },
+  { id: "emergency:chest-pain", type: "emergency", title: "Chest pain or collapse", keywords: ["chest pain", "collapsed", "fainted", "heart attack"] },
+  { id: "emergency:hypoxia", type: "emergency", title: "Low oxygen (hypoxia)", keywords: ["cant breathe", "short of breath", "dizzy", "low oxygen"] },
+];
+const index = buildSearchIndex(docs);
+const top = (q) => search(index, q).results[0]?.id;
+
+test("typos and misspellings", () => {
+  assert.equal(top("hart rate"), "indicator:heartRate");
+  assert.equal(top("temprature"), "indicator:temperature");
+});
+
+test("partial words while typing", () => {
+  assert.ok(search(index, "oxy").results.some((r) => r.id === "indicator:spo2"));
+});
+
+test("synonyms from keywords", () => {
+  assert.equal(top("pulse"), "indicator:heartRate");
+  assert.equal(top("sugar"), "indicator:glucose");
+  assert.equal(top("fever"), "indicator:temperature");
+});
+
+test("symptom queries put emergency guides first", () => {
+  const r = search(index, "chest pain");
+  assert.equal(r.symptomLike, true);
+  assert.equal(r.results[0].id, "emergency:chest-pain");
+  assert.equal(search(index, "can't breathe").results[0].type, "emergency");
+  assert.equal(search(index, "pulse").symptomLike, false);
+});
+
+test("case, punctuation, extra spaces and word order don't matter", () => {
+  assert.equal(normaliseQuery("  Heart,   RATE!! "), "heart rate");
+  assert.deepEqual(search(index, "RATE heart").results, search(index, "heart rate").results);
+});
+
+test("no match gives 'did you mean' and the emergency shortcut, never a dead end", () => {
+  const r = search(index, "zzqx");
+  assert.deepEqual([...r.results], []);
+  assert.equal(r.emergencyShortcut, true);
+  assert.equal(search(index, "   ").emergencyShortcut, true);
+  const near = search(index, "insomnai");
+  assert.ok(near.results.length > 0 || near.didYouMean.length > 0);
+});
+
+test("rejects duplicate ids", () => {
+  assert.throws(() => buildSearchIndex([{ id: "a", type: "indicator", title: "A" }, { id: "a", type: "indicator", title: "B" }]), TypeError);
+});
diff --git a/src/lib/engine/status.js b/src/lib/engine/status.js
