@@ -0,0 +1,99 @@
+// Indicator settings used by the logic engine (docs/CHECKLIST.md › 2. Logic).
+//
+// This is engine configuration, not health content: labels, guides and keywords
+// for people live with the content data (CHECKLIST §4). Field names follow the
+// daily record; until CHECKLIST §1 "Daily record defined" is done they are an
+// ASSUMPTION (camelCase, units in docs/SOURCES.md). Change them here only.
+
+/**
+ * Which change counts as worrying (docs/DECISIONS.md › Drift Cut-off):
+ * - "down": lower is worrying (sleep, mood, exercise, SpO₂)
+ * - "up": higher is worrying (reaction time, lapses)
+ * - "both": either way (vital signs)
+ *
+ * @typedef {"down" | "up" | "both"} Direction
+ */
+
+/**
+ * @typedef {Object} DriftIndicator
+ * @property {string} key       Field name in the daily record.
+ * @property {string} group     Linked indicators share a group and count once for alerts
+ *                              and the health score (DECISIONS › Drift Cut-off).
+ * @property {Direction} direction
+ * @property {number} sdFloor   Minimum spread `s` used by the drift formula, in the
+ *                              indicator's unit. ASSUMPTION: the team has not set these
+ *                              (DECISIONS › Drift Cut-off says "s has a minimum per
+ *                              indicator" but gives no values). Tune after simulator runs.
+ * @property {string} unit
+ */
+
+/**
+ * Indicators that get a baseline, a 7-day average, a z-score and a status.
+ * Core six from the challenge text first (DECISIONS › Indicators), then the daily
+ * extras, then optional SpO₂. Reaction false starts, symptoms and radiation dose are
+ * recorded but not drift-tracked: DECISIONS gives no worrying direction for false
+ * starts, symptoms aren't numbers, and radiation dose accumulates by design.
+ *
+ * @type {ReadonlyArray<Readonly<DriftIndicator>>}
+ */
+export const DRIFT_INDICATORS = Object.freeze(
+  [
+    { key: "heartRate", group: "heartRate", direction: "both", sdFloor: 2, unit: "bpm" },
+    { key: "bpSystolic", group: "bloodPressure", direction: "both", sdFloor: 3, unit: "mmHg" },
+    { key: "bpDiastolic", group: "bloodPressure", direction: "both", sdFloor: 2, unit: "mmHg" },
+    { key: "glucose", group: "glucose", direction: "both", sdFloor: 4, unit: "mg/dL" },
+    { key: "temperature", group: "temperature", direction: "both", sdFloor: 0.1, unit: "°C" },
+    { key: "sleepHours", group: "sleep", direction: "down", sdFloor: 0.25, unit: "h" },
+    { key: "mood", group: "mood", direction: "down", sdFloor: 0.3, unit: "1–5" },
+    { key: "reactionMedianMs", group: "reaction", direction: "up", sdFloor: 10, unit: "ms" },
+    { key: "reactionLapses", group: "reaction", direction: "up", sdFloor: 0.5, unit: "count" },
+    { key: "exerciseMinutes", group: "exercise", direction: "down", sdFloor: 5, unit: "min" },
+    { key: "spo2", group: "spo2", direction: "down", sdFloor: 0.5, unit: "%" },
+  ].map((indicator) => Object.freeze(indicator)),
+);
+
+/** Field names of the drift-tracked indicators, in display order. */
+export const DRIFT_INDICATOR_KEYS = Object.freeze(DRIFT_INDICATORS.map((i) => i.key));
+
+/** The mission-day field in every daily record (negative = pre-flight). */
+export const DAY_KEY = "missionDay";
+
+/**
+ * Looks up an indicator's settings.
+ *
+ * @param {string} key
+ * @returns {Readonly<DriftIndicator> | undefined}
+ */
+export function getIndicator(key) {
+  return DRIFT_INDICATORS.find((indicator) => indicator.key === key);
+}
+
+/**
+ * Lists the groups in display order with their member keys, e.g.
+ * { group: "bloodPressure", keys: ["bpSystolic", "bpDiastolic"] }.
+ *
+ * @returns {ReadonlyArray<{ group: string, keys: ReadonlyArray<string> }>}
+ */
+export function listGroups() {
+  const groups = [];
+  for (const indicator of DRIFT_INDICATORS) {
+    let entry = groups.find((g) => g.group === indicator.group);
+    if (!entry) {
+      entry = { group: indicator.group, keys: [] };
+      groups.push(entry);
+    }
+    entry.keys.push(indicator.key);
+  }
+  return Object.freeze(groups.map((g) => Object.freeze({ group: g.group, keys: Object.freeze(g.keys) })));
+}
+
+/**
+ * Returns the value only if it is a usable reading (a finite number). Anything else
+ * (missing, null, NaN, Infinity, text) is treated as "no reading".
+ *
+ * @param {unknown} value
+ * @returns {number | null}
+ */
+export function readingOrNull(value) {
+  return typeof value === "number" && Number.isFinite(value) ? value : null;
+}
