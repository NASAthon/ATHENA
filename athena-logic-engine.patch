+// Drift z-score (docs/CHECKLIST.md › 2. Logic, items 5 and 7).
+// Pure logic: no React, DOM, database or Node-only APIs.
+
+/**
+ * CHECKLIST §2: "Drift cut-off of z = 3.5". A design choice, not a clinical standard
+ * (DECISIONS › Drift Cut-off; also stated in README › Drift detection).
+ */
+export const DRIFT_CUTOFF = 3.5;
+
+/**
+ * @typedef {Object} DriftResult
+ * @property {number} z          Signed z: positive means the recent average is higher
+ *                               than the baseline.
+ * @property {number} worryingZ  z in the worrying direction only: −z for "down",
+ *                               z for "up", |z| for "both". Negative or 0 = no concern.
+ * @property {boolean} drifting  True when worryingZ ≥ DRIFT_CUTOFF.
+ * @property {number} s          Spread used: the baseline SD, raised to the floor if lower.
+ * @property {boolean} floorApplied True if the floor replaced a smaller baseline SD.
+ */
+
+/**
+ * CHECKLIST §2: "Z-score of the seven-day average against the in-flight baseline".
+ *
+ * Implements the locked formula (DECISIONS › Drift Cut-off):
+ *
+ *     z = (recent average − baseline mean) ÷ (s × √(1/n + 1/m))
+ *
+ * where s is the baseline's day-to-day SD, never below the indicator's floor.
+ * The function is generic, so the status step can also compare against the
+ * pre-flight baseline (for "expected adaptation").
+ *
+ * Returns null, never a guess, when either side lacks data: a recent average with
+ * status other than "ok", or a baseline whose status isn't "ok".
+ *
+ * @param {{ status: string, mean: number | null, n: number }} recent  From sevenDayAverage().
+ * @param {{ status: string, mean: number | null, sd: number | null, n: number }} baseline
+ *   One indicator's entry from calculateBaseline().
+ * @param {"down" | "up" | "both"} direction Worrying direction for this indicator.
+ * @param {number} sdFloor Minimum s for this indicator (> 0).
+ * @returns {Readonly<DriftResult> | null}
+ */
+export function driftZ(recent, baseline, direction, sdFloor) {
+  if (!(sdFloor > 0)) throw new RangeError("driftZ: sdFloor must be a positive number.");
+  if (!recent || recent.status !== "ok" || !baseline || baseline.status !== "ok") return null;
+  if (!(recent.n > 0) || !(baseline.n > 0)) return null;
+
+  const floorApplied = baseline.sd < sdFloor;
+  const s = floorApplied ? sdFloor : baseline.sd;
+  const z = (recent.mean - baseline.mean) / (s * Math.sqrt(1 / recent.n + 1 / baseline.n));
+
+  let worryingZ;
+  if (direction === "down") worryingZ = -z;
+  else if (direction === "up") worryingZ = z;
+  else if (direction === "both") worryingZ = Math.abs(z);
+  else throw new RangeError(`driftZ: unknown direction "${direction}".`);
+
+  // Normalise −0 so results compare equal in tests and storage.
+  if (Object.is(worryingZ, -0)) worryingZ = 0;
+
+  return Object.freeze({ z, worryingZ, drifting: worryingZ >= DRIFT_CUTOFF, s, floorApplied });
+}
diff --git a/src/lib/engine/drift.test.js b/src/lib/engine/drift.test.js
new file mode 100644
index 0000000..2e885d5
--- /dev/null
+++ b/src/lib/engine/drift.test.js
@@ -0,0 +1,41 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { DRIFT_CUTOFF, driftZ } from "./drift.js";
+
+const baseline = { status: "ok", mean: 7, sd: 0.5, n: 15 };
+
+test("implements z = (recent − mean) ÷ (s × √(1/n + 1/m))", () => {
+  const recent = { status: "ok", mean: 6, n: 7 };
+  const expected = (6 - 7) / (0.5 * Math.sqrt(1 / 7 + 1 / 15));
+  const result = driftZ(recent, baseline, "down", 0.25);
+  assert.equal(result.z, expected);
+  assert.equal(result.worryingZ, -expected);
+});
+
+test("cut-off is 3.5 and only the worrying direction counts", () => {
+  assert.equal(DRIFT_CUTOFF, 3.5);
+  const lower = { status: "ok", mean: 6, n: 7 }; // z ≈ −4.4
+  assert.equal(driftZ(lower, baseline, "down", 0.25).drifting, true);
+  assert.equal(driftZ(lower, baseline, "up", 0.25).drifting, false);
+  assert.equal(driftZ(lower, baseline, "both", 0.25).drifting, true);
+});
+
+test("the sd floor stops a very steady baseline from inflating z", () => {
+  const steady = { status: "ok", mean: 7, sd: 0.01, n: 15 };
+  const recent = { status: "ok", mean: 6.9, n: 7 };
+  const result = driftZ(recent, steady, "down", 0.25);
+  assert.equal(result.floorApplied, true);
+  assert.equal(result.s, 0.25);
+  assert.equal(result.drifting, false);
+});
+
+test("returns null when either side lacks data", () => {
+  assert.equal(driftZ({ status: "insufficient_data", mean: null, n: 2 }, baseline, "down", 0.25), null);
+  assert.equal(driftZ({ status: "ok", mean: 6, n: 7 }, { status: "no_data", mean: null, sd: null, n: 0 }, "down", 0.25), null);
+  assert.equal(driftZ({ status: "ok", mean: 6, n: 7 }, undefined, "down", 0.25), null);
+});
+
+test("rejects a missing floor or unknown direction", () => {
+  assert.throws(() => driftZ({ status: "ok", mean: 6, n: 7 }, baseline, "down", 0), RangeError);
+  assert.throws(() => driftZ({ status: "ok", mean: 6, n: 7 }, baseline, "sideways", 1), RangeError);
+});
diff --git a/src/lib/engine/evaluate.js b/src/lib/engine/evaluate.js
new file mode 100644
index 0000000..41b74c5
--- /dev/null
+++ b/src/lib/engine/evaluate.js
@@ -0,0 +1,85 @@
+// Day and mission evaluation: runs the logic items together.
+// Pure logic: no React, DOM, database or Node-only APIs.
+//
+// CHECKLIST §2 item 12, "Handles missing days without crashing or false alerts", is
+// met here and in every step below: missing days and values are skipped, fewer than
+// 4 readings in 7 days gives "no_data" (never "drifting"), and a day without data
+// neither starts nor ends an alert. Covered by evaluate.test.js.
+
+import { alertLevelOnDay, countDriftingGroups, groupStatuses } from "./alerts.js";
+import { healthScore, scoreChange } from "./healthScore.js";
+import { DAY_KEY } from "./indicators.js";
+import { checkReading } from "./redLimits.js";
+import { allIndicatorStatuses } from "./status.js";
+
+/**
+ * @typedef {Object} DayEvaluation
+ * @property {number} day
+ * @property {ReadonlyArray<Object>} indicators  Per-indicator statuses (status.js).
+ * @property {ReadonlyArray<Object>} groups      Per-group statuses (alerts.js).
+ * @property {ReadonlyArray<Object>} limitBreaches Today's reading vs red limits (redLimits.js).
+ * @property {{ level: string, driftingGroups: number | null, alertSince: number | null }} alert
+ * @property {Object} health Health score (healthScore.js).
+ * @property {{ sinceYesterday: number | null, over7Days: number | null }} change
+ */
+
+/**
+ * Evaluates every day from `fromDay` to `toDay` for ONE astronaut, in order, so the
+ * alert history and score changes are available. Days with no data still get an entry
+ * (with no_data statuses and a null score).
+ *
+ * Baselines are passed in, not recalculated: they are fixed (DECISIONS › Baselines).
+ *
+ * @param {ReadonlyArray<Object<string, unknown>>} records Daily records for ONE astronaut.
+ * @param {Parameters<typeof allIndicatorStatuses>[1]} baselines From calculateMissionBaselines().
+ * @param {number} fromDay First day to evaluate (integer).
+ * @param {number} toDay   Last day to evaluate (integer, ≥ fromDay).
+ * @returns {ReadonlyArray<Readonly<DayEvaluation>>}
+ * @throws {TypeError | RangeError} On invalid arguments.
+ */
+export function evaluateMission(records, baselines, fromDay, toDay) {
+  if (!Array.isArray(records)) throw new TypeError("evaluateMission: records must be an array.");
+  if (!Number.isInteger(fromDay) || !Number.isInteger(toDay)) {
+    throw new TypeError("evaluateMission: fromDay and toDay must be integers.");
+  }
+  if (fromDay > toDay) throw new RangeError("evaluateMission: fromDay must not be after toDay.");
+
+  const byDay = new Map();
+  for (const record of records) {
+    if (record !== null && typeof record === "object" && Number.isInteger(record[DAY_KEY])) {
+      byDay.set(record[DAY_KEY], record);
+    }
+  }
+
+  const history = [];
+  const scores = [];
+  const results = [];
+  for (let day = fromDay; day <= toDay; day += 1) {
+    const indicators = allIndicatorStatuses(records, baselines, day);
+    const groups = groupStatuses(indicators);
+    history.push({ day, driftingGroups: countDriftingGroups(groups) });
+    const alert = alertLevelOnDay(history, day);
+    const limitBreaches = checkReading(byDay.get(day));
+    const health = healthScore({ groups, limitBreaches, alertLevel: alert.level });
+    scores.push({ day, score: health.score });
+    results.push(
+      Object.freeze({ day, indicators, groups, limitBreaches, alert, health, change: scoreChange(scores, day) }),
+    );
+  }
+  return Object.freeze(results);
+}
+
+/**
+ * Evaluates a single day. Alert escalation needs history, so this evaluates from the
+ * first in-flight day (1) up to `day` and returns the last entry. For many days at once,
+ * use evaluateMission() instead.
+ *
+ * @param {ReadonlyArray<Object<string, unknown>>} records
+ * @param {Parameters<typeof allIndicatorStatuses>[1]} baselines
+ * @param {number} day
+ * @returns {Readonly<DayEvaluation>}
+ */
+export function evaluateDay(records, baselines, day) {
+  const results = evaluateMission(records, baselines, Math.min(1, day), day);
+  return results[results.length - 1];
+}
diff --git a/src/lib/engine/evaluate.test.js b/src/lib/engine/evaluate.test.js
new file mode 100644
index 0000000..24cf519
--- /dev/null
+++ b/src/lib/engine/evaluate.test.js
@@ -0,0 +1,79 @@
+// End-to-end checks on 180-day simulated missions (seeded, so always the same data).
+// These mirror CHECKLIST §6 tests for the three crew roles in DECISIONS › Crew.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { calculateMissionBaselines } from "./baseline.js";
+import { evaluateDay, evaluateMission } from "./evaluate.js";
+import { DRIFT_INDICATOR_KEYS } from "./indicators.js";
+import { buildSurgeonSummary } from "./summary.js";
+import { makeMission } from "./testData.js";
+
+/** Baselines from data up to day 35 only: they're fixed (DECISIONS › Baselines). */
+const baselinesFor = (records) =>
+  calculateMissionBaselines(records.filter((r) => r.missionDay <= 35), DRIFT_INDICATOR_KEYS);
+
+test("healthy astronaut (Singh): no alert all mission and a stable high score", () => {
+  for (const seed of [11, 12, 13]) {
+    const records = makeMission({ seed });
+    const days = evaluateMission(records, baselinesFor(records), 1, 180);
+    assert.ok(days.every((d) => ["none", "note"].includes(d.alert.level)), `seed ${seed}: false alert`);
+    const scores = days.map((d) => d.health.score).filter((s) => s !== null);
+    assert.ok(Math.min(...scores) >= 80, `seed ${seed}: score fell to ${Math.min(...scores)}`);
+  }
+});
+
+test("slow decline from day 75 (Rivera): alert appears, then escalates, and the score drops", () => {
+  const records = makeMission({
+    seed: 21,
+    shift: (d) => (d > 75 ? { sleepHours: -0.025 * (d - 75), mood: -0.02 * (d - 75), reactionMedianMs: 1.2 * (d - 75) } : {}),
+  });
+  const days = evaluateMission(records, baselinesFor(records), 1, 180);
+  const firstAlert = days.find((d) => d.alert.level === "alert");
+  assert.ok(firstAlert, "no alert raised");
+  assert.ok(firstAlert.day > 75 && firstAlert.day < 150, `alert on day ${firstAlert.day}`);
+  assert.ok(days.some((d) => d.alert.level === "escalated"), "never escalated");
+  assert.ok(firstAlert.health.score <= 79);
+  const day180 = days[days.length - 1];
+  assert.ok(day180.health.score < days[60].health.score);
+});
+
+test("one bad day produces no alert", () => {
+  const records = makeMission({ seed: 31, shift: (d) => (d === 100 ? { sleepHours: -4, mood: -2, reactionMedianMs: 150 } : {}) });
+  const days = evaluateMission(records, baselinesFor(records), 95, 110);
+  assert.ok(days.every((d) => d.alert.level !== "alert" && d.alert.level !== "escalated"));
+});
+
+test("dangerous reading (Nakamura): red limit caps the score at 25 that day", () => {
+  const records = makeMission({ seed: 41, toDay: 120 });
+  const event = records.find((r) => r.missionDay === 120);
+  event.bpSystolic = 195;
+  const today = evaluateDay(records, baselinesFor(records), 120);
+  assert.equal(today.limitBreaches[0].severity, "red");
+  assert.ok(today.health.score <= 25);
+  const summary = buildSurgeonSummary({ astronaut: "Engineer Nakamura", evaluation: today, earthOneWayMinutes: 20 });
+  assert.equal(summary.replyExpectedMinutes, 40);
+  assert.ok(summary.lines.some((l) => l.includes("heart.org")));
+});
+
+test("missing days: no crash and no false alert", () => {
+  const missing = [];
+  for (let d = 40; d <= 180; d += 1) if (d % 3 === 0 || (d >= 90 && d <= 104)) missing.push(d);
+  const records = makeMission({ seed: 51, missingDays: missing });
+  const days = evaluateMission(records, baselinesFor(records), 1, 180);
+  assert.equal(days.length, 180);
+  assert.ok(days.every((d) => ["none", "note"].includes(d.alert.level)));
+  const gap = days.find((d) => d.day === 100); // inside a 15-day gap
+  assert.equal(gap.health.score, null);
+  assert.ok(gap.indicators.every((i) => i.status === "no_data"));
+});
+
+test("empty data: everything is no_data and nothing throws", () => {
+  const days = evaluateMission([], {}, 1, 10);
+  assert.ok(days.every((d) => d.health.score === null && d.alert.level === "none"));
+});
+
+test("deterministic: same records give identical evaluations", () => {
+  const records = makeMission({ seed: 61, toDay: 60 });
+  const baselines = baselinesFor(records);
+  assert.deepEqual(evaluateMission(records, baselines, 1, 60), evaluateMission([...records].reverse(), baselines, 1, 60));
+});
diff --git a/src/lib/engine/healthScore.js b/src/lib/engine/healthScore.js
new file mode 100644
index 0000000..3b8c83b
--- /dev/null
+++ b/src/lib/engine/healthScore.js
@@ -0,0 +1,150 @@
+// Health score 0–100 (docs/CHECKLIST.md › 2. Logic, item 4).
+// Pure logic: no React, DOM, database or Node-only APIs.
+// Formula, caps and bands: docs/DECISIONS.md › Health Score.
+
+import { DRIFT_CUTOFF } from "./drift.js";
+import { getIndicator } from "./indicators.js";
+
+/** Sub-scores per status (DECISIONS › Health Score). */
+export const SUB_SCORES = Object.freeze({
+  steady: 100,
+  expected_adaptation: 90,
+  driftingStart: 80,
+  driftingPerZ: 20,
+  driftingFloor: 20,
+  redLimit: 0,
+});
+
+/** Score caps (DECISIONS › Health Score). */
+export const SCORE_CAPS = Object.freeze({ alert: 79, escalated: 59, redLimit: 25 });
+
+/** Bands, highest first (DECISIONS › Health Score). */
+export const SCORE_BANDS = Object.freeze([
+  Object.freeze({ band: "good", label: "Good", min: 80 }),
+  Object.freeze({ band: "watch", label: "Watch", min: 60 }),
+  Object.freeze({ band: "alert", label: "Alert", min: 40 }),
+  Object.freeze({ band: "critical", label: "Critical", min: 0 }),
+]);
+
+/**
+ * @typedef {Object} ScorePart
+ * @property {string} group
+ * @property {number} subScore
+ * @property {"red_limit" | "drifting" | "expected_adaptation" | "steady"} reason
+ * @property {number | null} worryingZ
+ */
+
+/**
+ * @typedef {Object} HealthScore
+ * @property {number | null} score  0–100, or null when no indicator has data.
+ * @property {"good" | "watch" | "alert" | "critical" | null} band
+ * @property {string | null} label  "Good", "Watch", "Alert" or "Critical".
+ * @property {number | null} cappedAt The cap that applied, if any.
+ * @property {ReadonlyArray<ScorePart>} parts Lowest sub-score first ("Why this score?").
+ */
+
+/**
+ * CHECKLIST §2: "Health score 0–100 per astronaut (100 = perfect)".
+ *
+ * Each linked group gets a sub-score: red limit today = 0; drifting =
+ * 80 − 20 × (z − 3.5), floored at 20; expected adaptation = 90; steady = 100. Groups
+ * with no data are left out. The score is the rounded average, then capped: 79 for an
+ * active alert, 59 for an escalated alert, 25 for any red limit.
+ *
+ * @param {Object} input
+ * @param {ReadonlyArray<{ group: string, status: string, worryingZ: number | null }>} input.groups
+ *   From groupStatuses().
+ * @param {ReadonlyArray<{ indicator: string, severity: string }>} [input.limitBreaches]
+ *   From checkReading() for today's reading; only "red" ones count.
+ * @param {"none" | "note" | "alert" | "escalated"} [input.alertLevel]
+ * @returns {Readonly<HealthScore>}
+ */
+export function healthScore({ groups, limitBreaches = [], alertLevel = "none" }) {
+  const redGroups = new Set(
+    limitBreaches
+      .filter((breach) => breach.severity === "red")
+      .map((breach) => getIndicator(breach.indicator)?.group ?? breach.indicator),
+  );
+
+  /** @type {ScorePart[]} */
+  const parts = [];
+  for (const g of groups) {
+    if (redGroups.has(g.group)) {
+      parts.push({ group: g.group, subScore: SUB_SCORES.redLimit, reason: "red_limit", worryingZ: g.worryingZ });
+    } else if (g.status === "drifting") {
+      const z = g.worryingZ ?? DRIFT_CUTOFF;
+      const sub = Math.max(
+        SUB_SCORES.driftingFloor,
+        SUB_SCORES.driftingStart - SUB_SCORES.driftingPerZ * (z - DRIFT_CUTOFF),
+      );
+      parts.push({ group: g.group, subScore: sub, reason: "drifting", worryingZ: g.worryingZ });
+    } else if (g.status === "expected_adaptation") {
+      parts.push({ group: g.group, subScore: SUB_SCORES.expected_adaptation, reason: "expected_adaptation", worryingZ: g.worryingZ });
+    } else if (g.status === "steady") {
+      parts.push({ group: g.group, subScore: SUB_SCORES.steady, reason: "steady", worryingZ: g.worryingZ });
+    }
+  }
+  // A red limit on an indicator whose group had no drift data still counts.
+  for (const group of redGroups) {
+    if (!parts.some((p) => p.group === group)) {
+      parts.push({ group, subScore: SUB_SCORES.redLimit, reason: "red_limit", worryingZ: null });
+    }
+  }
+
+  if (parts.length === 0) {
+    return Object.freeze({ score: null, band: null, label: null, cappedAt: null, parts: Object.freeze([]) });
+  }
+
+  const average = parts.reduce((sum, p) => sum + p.subScore, 0) / parts.length;
+  let score = Math.round(average);
+
+  const caps = [];
+  if (alertLevel === "alert") caps.push(SCORE_CAPS.alert);
+  if (alertLevel === "escalated") caps.push(SCORE_CAPS.escalated);
+  if (redGroups.size > 0) caps.push(SCORE_CAPS.redLimit);
+  const cap = caps.length > 0 ? Math.min(...caps) : null;
+  let cappedAt = null;
+  if (cap !== null && score > cap) {
+    score = cap;
+    cappedAt = cap;
+  }
+
+  const { band, label } = scoreBand(score);
+  const sortedParts = [...parts]
+    .sort((a, b) => a.subScore - b.subScore || a.group.localeCompare(b.group))
+    .map((p) => Object.freeze(p));
+  return Object.freeze({ score, band, label, cappedAt, parts: Object.freeze(sortedParts) });
+}
+
+/**
+ * Band for a score (80–100 Good, 60–79 Watch, 40–59 Alert, 0–39 Critical).
+ *
+ * @param {number} score
+ * @returns {{ band: "good" | "watch" | "alert" | "critical", label: string }}
+ */
+export function scoreBand(score) {
+  const found = SCORE_BANDS.find((b) => score >= b.min) ?? SCORE_BANDS[SCORE_BANDS.length - 1];
+  return { band: found.band, label: found.label };
+}
+
+/**
+ * CHECKLIST §2: "…with the change since yesterday and over 7 days".
+ *
+ * @param {ReadonlyArray<{ day: number, score: number | null }>} scores One entry per day.
+ * @param {number} day
+ * @returns {Readonly<{ sinceYesterday: number | null, over7Days: number | null }>}
+ *   Positive = improved. Null when either score is missing.
+ */
+export function scoreChange(scores, day) {
+  const at = (d) => {
+    const entry = scores.find((s) => s.day === d);
+    return entry && typeof entry.score === "number" ? entry.score : null;
+  };
+  const today = at(day);
+  const yesterday = at(day - 1);
+  const weekAgo = at(day - 7);
+  return Object.freeze({
+    sinceYesterday: today !== null && yesterday !== null ? today - yesterday : null,
+    over7Days: today !== null && weekAgo !== null ? today - weekAgo : null,
+  });
+}
diff --git a/src/lib/engine/healthScore.test.js b/src/lib/engine/healthScore.test.js
new file mode 100644
index 0000000..00a4b5e
--- /dev/null
+++ b/src/lib/engine/healthScore.test.js
@@ -0,0 +1,42 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { healthScore, scoreBand, scoreChange } from "./healthScore.js";
+
+const g = (group, status, worryingZ = null) => ({ group, status, worryingZ });
+
+test("all steady = 100 Good; no data = null", () => {
+  assert.deepEqual({ ...healthScore({ groups: [g("mood", "steady"), g("sleep", "steady")] }), parts: undefined }, { score: 100, band: "good", label: "Good", cappedAt: null, parts: undefined });
+  assert.equal(healthScore({ groups: [g("mood", "no_data")] }).score, null);
+});
+
+test("sub-scores follow DECISIONS › Health Score", () => {
+  assert.equal(healthScore({ groups: [g("a", "expected_adaptation")] }).score, 90);
+  assert.equal(healthScore({ groups: [g("a", "drifting", 3.5)] }).score, 80);
+  assert.equal(healthScore({ groups: [g("a", "drifting", 4.5)] }).score, 60);
+  assert.equal(healthScore({ groups: [g("a", "drifting", 99)] }).score, 20); // floor
+});
+
+test("caps: alert 79, escalated 59, red limit 25", () => {
+  const groups = [g("a", "drifting", 3.6), g("b", "drifting", 3.6), ...Array.from({ length: 7 }, (_, i) => g(`s${i}`, "steady"))];
+  assert.equal(healthScore({ groups }).score, 95); // (2 × 78 + 7 × 100) ÷ 9 = 95.1
+  assert.equal(healthScore({ groups, alertLevel: "alert" }).score, 79);
+  assert.equal(healthScore({ groups, alertLevel: "escalated" }).score, 59);
+  const red = healthScore({ groups, alertLevel: "alert", limitBreaches: [{ indicator: "bpSystolic", severity: "red" }] });
+  assert.equal(red.score, 25);
+  assert.equal(red.label, "Critical");
+  assert.equal(red.parts[0].reason, "red_limit");
+});
+
+test("act/watch breaches don't change the score", () => {
+  assert.equal(healthScore({ groups: [g("glucose", "steady")], limitBreaches: [{ indicator: "glucose", severity: "act" }] }).score, 100);
+});
+
+test("bands", () => {
+  assert.deepEqual([80, 79, 60, 59, 40, 39, 0].map((s) => scoreBand(s).label), ["Good", "Watch", "Watch", "Alert", "Alert", "Critical", "Critical"]);
+});
+
+test("change since yesterday and over 7 days", () => {
+  const scores = [{ day: 1, score: 90 }, { day: 7, score: 85 }, { day: 8, score: 72 }];
+  assert.deepEqual({ ...scoreChange(scores, 8) }, { sinceYesterday: -13, over7Days: -18 });
+  assert.deepEqual({ ...scoreChange(scores, 7) }, { sinceYesterday: null, over7Days: null });
+});
