diff --git a/src/lib/engine/reminders.js b/src/lib/engine/reminders.js
new file mode 100644
index 0000000..c561f6e
--- /dev/null
+++ b/src/lib/engine/reminders.js
@@ -0,0 +1,66 @@
+// Reminder scheduler (docs/CHECKLIST.md › 2. Logic, item 14).
+// Pure logic: no React, DOM, database or Node-only APIs.
+
+import { readingOrNull } from "./indicators.js";
+
+/**
+ * Measurements the crew is reminded to take. ASSUMPTION: every one is due once per
+ * mission day; the team hasn't set a schedule. The six core indicators come from the
+ * challenge text, then the daily extras (DECISIONS › Indicators). Optional SpO₂ and
+ * radiation dose are not reminded. Blood pressure counts as one measurement with two
+ * numbers, so it's due until both are recorded.
+ *
+ * @type {ReadonlyArray<Readonly<{ id: string, fields: ReadonlyArray<string>, everyDays: number }>>}
+ */
+export const MEASUREMENT_SCHEDULE = Object.freeze(
+  [
+    { id: "heartRate", fields: ["heartRate"], everyDays: 1 },
+    { id: "bloodPressure", fields: ["bpSystolic", "bpDiastolic"], everyDays: 1 },
+    { id: "glucose", fields: ["glucose"], everyDays: 1 },
+    { id: "temperature", fields: ["temperature"], everyDays: 1 },
+    { id: "sleepHours", fields: ["sleepHours"], everyDays: 1 },
+    { id: "mood", fields: ["mood"], everyDays: 1 },
+    { id: "reactionTest", fields: ["reactionMedianMs"], everyDays: 1 },
+    { id: "exerciseMinutes", fields: ["exerciseMinutes"], everyDays: 1 },
+    { id: "symptoms", fields: ["symptoms"], everyDays: 1 },
+  ].map((m) => Object.freeze({ ...m, fields: Object.freeze(m.fields) })),
+);
+
+/**
+ * True if a field holds a recorded value. Symptoms are a list, and an EMPTY list counts
+ * as recorded ("no symptoms today" is an answer). Everything else must be a finite number.
+ *
+ * @param {string} field
+ * @param {unknown} value
+ * @returns {boolean}
+ */
+function isRecorded(field, value) {
+  if (field === "symptoms") return Array.isArray(value);
+  return readingOrNull(value) !== null;
+}
+
+/**
+ * CHECKLIST §2: "Reminder scheduler: which measurements are due today".
+ *
+ * Returns the scheduled measurements that today's record doesn't have yet, in schedule
+ * order. With no record at all, everything due today is returned. A measurement with
+ * `everyDays` > 1 is due on mission days where (day − 1) is a multiple of it
+ * (day 1, 1 + everyDays, …); nothing is due before day 1.
+ *
+ * @param {Object<string, unknown> | null | undefined} todayRecord The record for `day`, if any.
+ * @param {number} day Mission day (integer).
+ * @param {typeof MEASUREMENT_SCHEDULE} [schedule=MEASUREMENT_SCHEDULE]
+ * @returns {ReadonlyArray<string>} Measurement ids still due, e.g. ["glucose", "mood"].
+ * @throws {TypeError} If `day` isn't an integer.
+ */
+export function dueMeasurements(todayRecord, day, schedule = MEASUREMENT_SCHEDULE) {
+  if (!Number.isInteger(day)) throw new TypeError("dueMeasurements: day must be an integer.");
+  if (day < 1) return Object.freeze([]);
+
+  const record = todayRecord !== null && typeof todayRecord === "object" ? todayRecord : {};
+  const due = schedule
+    .filter((m) => (day - 1) % m.everyDays === 0)
+    .filter((m) => !m.fields.every((field) => isRecorded(field, record[field])))
+    .map((m) => m.id);
+  return Object.freeze(due);
+}
