+++ b/src/lib/engine/redLimits.test.js
@@ -0,0 +1,45 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { checkReading, hasRedLimit, LIMIT_RULES, RANGE_LABEL } from "./redLimits.js";
+
+test("normal reading breaches nothing", () => {
+  assert.deepEqual([...checkReading({ heartRate: 70, bpSystolic: 115, bpDiastolic: 75, glucose: 90, temperature: 36.8, sleepHours: 7.5 })], []);
+});
+
+test("severe blood pressure is a red limit (AHA: above 180 and/or above 120)", () => {
+  assert.equal(hasRedLimit({ bpSystolic: 181, bpDiastolic: 80 }), true);
+  assert.equal(hasRedLimit({ bpSystolic: 150, bpDiastolic: 121 }), true);
+  assert.equal(hasRedLimit({ bpSystolic: 180, bpDiastolic: 120 }), false); // "higher than", so 180/120 itself isn't
+  assert.equal(checkReading({ bpSystolic: 185 })[0].confirm, "Wait 5 minutes and measure again.");
+});
+
+test("glucose reports only the most severe level", () => {
+  const breaches = checkReading({ glucose: 50 });
+  assert.equal(breaches.length, 1);
+  assert.equal(breaches[0].ruleId, "glucose-level2-low");
+  assert.equal(checkReading({ glucose: 60 })[0].severity, "act");
+  assert.equal(checkReading({ glucose: 54 })[0].ruleId, "glucose-level1-low"); // 54 is level 1
+});
+
+test("temperature: below 35 °C is red, 38 °C is a fever", () => {
+  assert.equal(checkReading({ temperature: 34.9 })[0].severity, "red");
+  assert.equal(checkReading({ temperature: 38 })[0].ruleId, "temperature-fever");
+});
+
+test("results are sorted red first and every one is cited and labelled", () => {
+  const breaches = checkReading({ sleepHours: 5, temperature: 34, glucose: 65 });
+  assert.deepEqual(breaches.map((b) => b.severity), ["red", "act", "watch"]);
+  for (const b of breaches) {
+    assert.equal(b.rangeLabel, RANGE_LABEL);
+    assert.match(b.source.url, /^https:\/\//);
+  }
+});
+
+test("works on the first reading ever and ignores missing or invalid values", () => {
+  assert.deepEqual([...checkReading(null)], []);
+  assert.deepEqual([...checkReading({ glucose: "40", temperature: Number.NaN })], []);
+});
+
+test("every rule cites one of the verified sources", () => {
+  for (const rule of LIMIT_RULES) assert.ok(rule.source, rule.id);
+});
diff --git a/src/lib/engine/regions.js b/src/lib/engine/regions.js
