@@ -0,0 +1,216 @@
+// Red-limit check (docs/CHECKLIST.md › 2. Logic, items 9 and 10).
+// Pure logic: no React, DOM, database or Node-only APIs.
+//
+// Every number below is a general clinical reference range, NOT a NASA flight
+// standard (DECISIONS › Thresholds, › Red-Limit Sources). Each was checked against
+// the live source page on 14 Nov 2026 and is listed in docs/SOURCES.md. Values
+// without a verified source are deliberately absent (see RED_LIMIT_GAPS).
+// Glucose is in mg/dL and temperature in °C.
+
+import { readingOrNull } from "./indicators.js";
+
+/** Label every threshold must carry in the app (DECISIONS › Thresholds). */
+export const RANGE_LABEL = "general clinical reference range";
+
+/** Source pages, as listed in docs/SOURCES.md. */
+export const LIMIT_SOURCES = Object.freeze({
+  ahaHeartRate: Object.freeze({
+    name: "American Heart Association: All About Heart Rate",
+    url: "https://www.heart.org/en/health-topics/high-blood-pressure/the-facts-about-high-blood-pressure/all-about-heart-rate-pulse",
+  }),
+  ahaBloodPressure: Object.freeze({
+    name: "American Heart Association: Understanding Blood Pressure Readings",
+    url: "https://www.heart.org/en/health-topics/high-blood-pressure/understanding-blood-pressure-readings",
+  }),
+  adaHypoglycemia: Object.freeze({
+    name: "American Diabetes Association: Hypoglycemia (Standards of Care 2025)",
+    url: "https://professional.diabetes.org/sites/dpro/files/2025-05/hypoglycemia-patient-5-27-25.pdf",
+  }),
+  adaDiagnosis: Object.freeze({
+    name: "American Diabetes Association: Diabetes Diagnosis",
+    url: "https://diabetes.org/about-diabetes/diagnosis",
+  }),
+  cdcFever: Object.freeze({
+    name: "CDC: Definitions of Signs, Symptoms, and Conditions of Ill Travelers",
+    url: "https://www.cdc.gov/port-health/php/definitions-symptoms-reportable-illness/index.html",
+  }),
+  cdcHypothermia: Object.freeze({
+    name: "CDC: Preventing Hypothermia",
+    url: "https://www.cdc.gov/winter-weather/prevention/index.html",
+  }),
+  cdcSleep: Object.freeze({
+    name: "CDC: FastStats, Sleep in Adults",
+    url: "https://www.cdc.gov/sleep/data-research/facts-stats/adults-sleep-facts-and-stats.html",
+  }),
+});
+
+/**
+ * Severity of a breached limit:
+ * - "red": red limit; opens the red-limit/emergency screen and caps the health score at 25.
+ * - "act": the source gives an action (re-measure, tell the flight surgeon), not an emergency.
+ * - "watch": outside the normal range; worth noting.
+ *
+ * @typedef {"red" | "act" | "watch"} Severity
+ */
+
+/**
+ * @typedef {Object} LimitRule
+ * @property {string} id
+ * @property {string} indicator Daily-record field name.
+ * @property {"<" | ">" | ">="} op
+ * @property {number} value
+ * @property {Severity} severity
+ * @property {string} summary   Short engine-side description; plain-English guidance
+ *                              text for people belongs to the content data (CHECKLIST §4).
+ * @property {string | null} confirm Re-check the source asks for before acting, if any.
+ * @property {keyof typeof LIMIT_SOURCES} source
+ */
+
+/** @type {ReadonlyArray<Readonly<LimitRule>>} */
+export const LIMIT_RULES = Object.freeze(
+  [
+    // Blood pressure (AHA): above 180 and/or above 120 is severe.
+    { id: "bp-systolic-severe", indicator: "bpSystolic", op: ">", value: 180, severity: "red",
+      summary: "Systolic blood pressure above 180 mmHg (severe).",
+      confirm: "Wait 5 minutes and measure again.", source: "ahaBloodPressure" },
+    { id: "bp-diastolic-severe", indicator: "bpDiastolic", op: ">", value: 120, severity: "red",
+      summary: "Diastolic blood pressure above 120 mmHg (severe).",
+      confirm: "Wait 5 minutes and measure again.", source: "ahaBloodPressure" },
+    { id: "bp-systolic-stage2", indicator: "bpSystolic", op: ">=", value: 140, severity: "watch",
+      summary: "Systolic blood pressure 140 mmHg or higher (stage 2 high).", confirm: null,
+      source: "ahaBloodPressure" },
+    { id: "bp-diastolic-stage2", indicator: "bpDiastolic", op: ">=", value: 90, severity: "watch",
+      summary: "Diastolic blood pressure 90 mmHg or higher (stage 2 high).", confirm: null,
+      source: "ahaBloodPressure" },
+
+    // Blood glucose (ADA), mg/dL.
+    { id: "glucose-level2-low", indicator: "glucose", op: "<", value: 54, severity: "red",
+      summary: "Blood glucose below 54 mg/dL (level 2 low).", confirm: null, source: "adaHypoglycemia" },
+    { id: "glucose-level1-low", indicator: "glucose", op: "<", value: 70, severity: "act",
+      summary: "Blood glucose below 70 mg/dL (level 1 low).", confirm: null, source: "adaHypoglycemia" },
+    { id: "glucose-fasting-high", indicator: "glucose", op: ">=", value: 126, severity: "act",
+      summary: "Fasting blood glucose 126 mg/dL or higher.",
+      confirm: "Measure again, fasting, on another day: one reading is not a diagnosis.",
+      source: "adaDiagnosis" },
+
+    // Body temperature (CDC), °C.
+    { id: "temperature-hypothermia", indicator: "temperature", op: "<", value: 35, severity: "red",
+      summary: "Body temperature below 35 °C (possible hypothermia).", confirm: null,
+      source: "cdcHypothermia" },
+    { id: "temperature-fever", indicator: "temperature", op: ">=", value: 38, severity: "act",
+      summary: "Body temperature 38 °C or higher (fever).", confirm: null, source: "cdcFever" },
+
+    // Heart rate at rest (AHA): outside 60–100 bpm.
+    { id: "heart-rate-high", indicator: "heartRate", op: ">", value: 100, severity: "watch",
+      summary: "Resting heart rate above 100 bpm.", confirm: "Re-measure sitting, calm, after rest.",
+      source: "ahaHeartRate" },
+    { id: "heart-rate-low", indicator: "heartRate", op: "<", value: 60, severity: "watch",
+      summary: "Resting heart rate below 60 bpm (can be normal for very fit people).",
+      confirm: null, source: "ahaHeartRate" },
+
+    // Sleep (CDC): fewer than 7 hours.
+    { id: "sleep-short", indicator: "sleepHours", op: "<", value: 7, severity: "watch",
+      summary: "Less than 7 hours of sleep.", confirm: null, source: "cdcSleep" },
+  ].map((rule) => Object.freeze(rule)),
+);
+
+/**
+ * Limits the team still has to source before they can exist (docs/SOURCES.md › Gaps).
+ * Kept here so the gap is visible to anyone reading the engine.
+ */
+export const RED_LIMIT_GAPS = Object.freeze([
+  "heartRate: no fixed red limit (AHA: suddenly very high or low *for you*)",
+  "glucose: no verified high red limit for people without diabetes",
+  "temperature: no verified high red limit above fever",
+  "bpSystolic/bpDiastolic: no verified low blood pressure limit",
+  "spo2: no allowed source chosen yet",
+]);
+
+const SEVERITY_ORDER = Object.freeze({ red: 0, act: 1, watch: 2 });
+
+/**
+ * @typedef {Object} LimitBreach
+ * @property {string} ruleId
+ * @property {string} indicator
+ * @property {number} value       The reading that breached the limit.
+ * @property {number} limit
+ * @property {string} op
+ * @property {Severity} severity
+ * @property {string} summary
+ * @property {string | null} confirm
+ * @property {{ name: string, url: string }} source
+ * @property {string} rangeLabel  Always RANGE_LABEL.
+ */
+
+/**
+ * CHECKLIST §2: "Red-limit check on every new reading, independent of baselines" and
+ * "Red limits taken from a published source and cited".
+ *
+ * Checks ONE reading (a daily record, or a partial record such as emergency vitals)
+ * against the fixed limits. Uses no baseline and no history, so it works from the
+ * very first reading. Missing or invalid values are skipped.
+ *
+ * For each indicator only the most severe breached rule is reported (e.g. glucose 50
+ * reports "level 2 low", not also "level 1 low"). Results are sorted red → act → watch,
+ * then by rule order, so the output is deterministic.
+ *
+ * @param {Object<string, unknown> | null | undefined} reading
+ * @returns {ReadonlyArray<Readonly<LimitBreach>>}
+ */
+export function checkReading(reading) {
+  if (reading === null || typeof reading !== "object") return Object.freeze([]);
+
+  /** @type {Map<string, { rule: Readonly<LimitRule>, index: number, value: number }>} */
+  const worstPerIndicator = new Map();
+  LIMIT_RULES.forEach((rule, index) => {
+    const value = readingOrNull(reading[rule.indicator]);
+    if (value === null || !breaches(value, rule.op, rule.value)) return;
+    const current = worstPerIndicator.get(rule.indicator);
+    if (!current || SEVERITY_ORDER[rule.severity] < SEVERITY_ORDER[current.rule.severity]) {
+      worstPerIndicator.set(rule.indicator, { rule, index, value });
+    }
+  });
+
+  const found = [...worstPerIndicator.values()].sort(
+    (a, b) => SEVERITY_ORDER[a.rule.severity] - SEVERITY_ORDER[b.rule.severity] || a.index - b.index,
+  );
+  return Object.freeze(
+    found.map(({ rule, value }) =>
+      Object.freeze({
+        ruleId: rule.id,
+        indicator: rule.indicator,
+        value,
+        limit: rule.value,
+        op: rule.op,
+        severity: rule.severity,
+        summary: rule.summary,
+        confirm: rule.confirm,
+        source: LIMIT_SOURCES[rule.source],
+        rangeLabel: RANGE_LABEL,
+      }),
+    ),
+  );
+}
+
+/**
+ * True if the reading breaches any red limit.
+ *
+ * @param {Object<string, unknown> | null | undefined} reading
+ * @returns {boolean}
+ */
+export function hasRedLimit(reading) {
+  return checkReading(reading).some((breach) => breach.severity === "red");
+}
+
+/**
+ * @param {number} value
+ * @param {string} op
+ * @param {number} limit
+ * @returns {boolean}
+ */
+function breaches(value, op, limit) {
+  if (op === "<") return value < limit;
+  if (op === ">") return value > limit;
+  if (op === ">=") return value >= limit;
+  throw new RangeError(`Unknown operator "${op}".`);
+}
diff --git a/src/lib/engine/redLimits.test.js b/src/lib/engine/redLimits.test.js
