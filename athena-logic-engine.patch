index 0000000..e84613f
--- /dev/null
+++ b/src/lib/engine/regions.js
@@ -0,0 +1,68 @@
+// Region mapper (docs/CHECKLIST.md › 2. Logic, S item "Region mapper").
+// Pure logic: no React, DOM, database or Node-only APIs.
+//
+// The 8 regions and their indicators come from docs/BODY_MAP.md (verified 14 Nov).
+// That file's last check, "Indicators per region agreed with the logic owner", is
+// still open: this table is the proposal to agree. Region cards (function, risks,
+// hazards, sources) are content and live elsewhere.
+
+import { getIndicator } from "./indicators.js";
+
+/**
+ * Region id → drift-tracked indicators shown on that region. Regions 2 (eyes) have
+ * only symptoms in BODY_MAP.md, so no numeric indicator.
+ *
+ * @type {ReadonlyArray<Readonly<{ id: string, name: string, indicators: ReadonlyArray<string> }>>}
+ */
+export const REGIONS = Object.freeze(
+  [
+    { id: "brain", name: "Brain and nerves", indicators: ["reactionMedianMs", "reactionLapses"] },
+    { id: "eyes", name: "Eyes", indicators: [] },
+    { id: "mindSleep", name: "Mind and sleep", indicators: ["mood", "sleepHours", "reactionMedianMs", "reactionLapses"] },
+    { id: "heart", name: "Heart and blood vessels", indicators: ["heartRate", "bpSystolic", "bpDiastolic", "exerciseMinutes"] },
+    { id: "breathing", name: "Breathing and oxygen", indicators: ["spo2"] },
+    { id: "musclesBones", name: "Muscles and bones", indicators: ["exerciseMinutes"] },
+    { id: "gutNutrition", name: "Gut, kidneys and nutrition", indicators: ["glucose"] },
+    { id: "immuneSkinBlood", name: "Immune system, skin and blood", indicators: ["temperature"] },
+  ].map((r) => Object.freeze({ ...r, indicators: Object.freeze(r.indicators) })),
+);
+
+/** Region statuses, most to least severe. */
+const REGION_RANK = Object.freeze(["red_limit", "drifting", "expected_adaptation", "steady", "no_data"]);
+
+/**
+ * CHECKLIST §2 (S): "Region mapper: indicator-to-body-region table and worst-status function".
+ *
+ * Worst status among a region's indicators: a red limit on today's reading beats
+ * drifting, which beats expected adaptation, then steady. A region with no data (or
+ * no numeric indicators) is "no_data".
+ *
+ * @param {string} regionId
+ * @param {ReadonlyArray<{ key: string, status: string }>} indicatorStatuses From allIndicatorStatuses().
+ * @param {ReadonlyArray<{ indicator: string, severity: string }>} [limitBreaches] From checkReading().
+ * @returns {"red_limit" | "drifting" | "expected_adaptation" | "steady" | "no_data"}
+ * @throws {RangeError} If the region id is unknown.
+ */
+export function regionStatus(regionId, indicatorStatuses, limitBreaches = []) {
+  const region = REGIONS.find((r) => r.id === regionId);
+  if (!region) throw new RangeError(`regionStatus: unknown region "${regionId}".`);
+
+  const found = new Set();
+  for (const key of region.indicators) {
+    if (limitBreaches.some((b) => b.indicator === key && b.severity === "red")) found.add("red_limit");
+    const status = indicatorStatuses.find((s) => s.key === key)?.status;
+    if (status) found.add(status);
+  }
+  return /** @type {any} */ (REGION_RANK.find((s) => found.has(s)) ?? "no_data");
+}
+
+/**
+ * Which regions show an indicator (for linking an alert to the body figure).
+ *
+ * @param {string} indicatorKey
+ * @returns {ReadonlyArray<string>} Region ids.
+ */
+export function regionsForIndicator(indicatorKey) {
+  if (!getIndicator(indicatorKey)) return Object.freeze([]);
+  return Object.freeze(REGIONS.filter((r) => r.indicators.includes(indicatorKey)).map((r) => r.id));
+}
